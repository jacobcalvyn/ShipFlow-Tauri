{
  "name": "shipflow-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ShipFlow Desktop suite with an Electron shell and Rust data engines",
  "author": "ShipFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobcalvyn/ShipFlow-Tauri.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:native:debug && electron-vite dev",
    "dev:web": "vite",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:service:web": "vite --host 127.0.0.1 --port 1432 --strictPort",
    "dev:service": "node ./scripts/run-service-dev.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "build:native:debug": "cargo build -p shipflow-service -p shipflow-workspace-host",
    "build:native": "cargo build -p shipflow-service -p shipflow-workspace-host --release",
    "package": "npm run build:native && npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:dir": "npm run build:native && npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "package:macos": "npm run build:native && npm run build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:macos:installer": "npm run build:native && npm run build && electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "package:windows": "npm run build:native && npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "package:verify": "node scripts/verify-electron-package.mjs",
    "build:service": "cargo build --manifest-path apps/service/Cargo.toml --release",
    "build:bundle": "npm run package",
    "build:bundle:macos": "npm run package:macos",
    "build:bundle:nsis": "npm run package:windows",
    "build:updater": "npm run package",
    "test": "vitest run --exclude src/features/sheet/components/SheetTable.benchmark.test.tsx --exclude \"tests/e2e/**\" --exclude \"tests/electron/**\"",
    "test:e2e": "npm run build:native:debug && npm run build && playwright test",
    "test:electron:package": "playwright test tests/electron/packaged-smoke.spec.ts",
    "test:diagnostics": "node --test scripts/audit-runtime-log.node-test.mjs",
    "security:baseline": "node scripts/verify-security-baseline.mjs",
    "diagnostics:log": "node scripts/audit-runtime-log.mjs",
    "bench:table": "vitest run src/features/sheet/components/SheetTable.benchmark.test.tsx --environment jsdom --reporter=verbose",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
