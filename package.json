{
  "name": "shipflow3-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:service:web": "vite --host 127.0.0.1 --port 1432 --strictPort",
    "dev:service": "node ./scripts/run-service-dev.mjs",
    "build": "tsc && vite build",
    "build:service": "cargo build --manifest-path apps/service/Cargo.toml --release --features custom-protocol",
    "build:bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "build:bundle:macos": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles app",
    "build:bundle:nsis": "tauri build --config src-tauri/tauri.bundle.conf.json --no-bundle && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-desktop-installer.ps1",
    "build:service:bundle:macos": "npm run build && cd apps/service && ../../node_modules/.bin/tauri build --features custom-protocol --bundles app --ci",
    "build:updater:desktop": "node scripts/build-updater-artifacts.mjs desktop",
    "build:updater:service": "node scripts/build-updater-artifacts.mjs service",
    "test": "vitest run --exclude src/features/sheet/components/SheetTable.benchmark.test.tsx --exclude \"tests/e2e/**\"",
    "test:e2e": "playwright test",
    "security:baseline": "node scripts/verify-security-baseline.mjs",
    "bench:table": "vitest run src/features/sheet/components/SheetTable.benchmark.test.tsx --environment jsdom --reporter=verbose",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@tauri-apps/api": "^2.10.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
